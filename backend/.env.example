# ===========================================
# PresAI Backend Configuration
# ===========================================

# File Storage
FILE_STORAGE_PATH=content

# Vector Database
QDRANT_URL=http://localhost:6333
VECTOR_SIZE=768

# ===========================================
# Embedding Configuration
# Choose ONE provider and uncomment it
# ===========================================

# Option 1: Ollama (Local - Recommended for development)
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_BASE_URL=http://localhost:11434
EMBEDDINGS_MODEL=nomic-embed-text

# Option 2: LM Studio (Local)
# EMBEDDINGS_PROVIDER=lmstudio
# EMBEDDINGS_BASE_URL=http://localhost:1234
# EMBEDDINGS_MODEL=your_model

# Option 3: Groq (Cloud)
# EMBEDDINGS_PROVIDER=groq
# EMBEDDINGS_API_KEY=your_groq_api_key
# EMBEDDINGS_MODEL=text-embedding-004

# Option 4: OpenAI (Cloud)
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_API_KEY=your_openai_key
# EMBEDDINGS_MODEL=text-embedding-3-small

# ===========================================
# Voice Configuration
# ===========================================

# Voice mode: local (default) | agentkit_live
# - local: Uses local LiveKit server + Deepgram plugin directly
# - agentkit_live: Uses LiveKit Cloud for production deployment
VOICE_MODE=local

# LiveKit Server Configuration
# For local development (Docker)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsec

# For LiveKit Cloud (agentkit_live mode only)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret_min_32_chars

LIVEKIT_ROOM_PREFIX=presai-voice
LIVEKIT_TOKEN_TTL_SECONDS=3600

# API Keys for Voice Services
DEEPGRAM_API_KEY=your_deepgram_api_key
GROQ_API_KEY=your_groq_api_key

# Inference Model Settings
# STT (Speech-to-Text): Deepgram models
# Note: Use 'nova-3' for LiveKit plugin compatibility
# Flux models require /v2/listen endpoint which isn't supported in current LiveKit plugin
INFERENCE_STT_MODEL=nova-3
INFERENCE_STT_ENCODING=pcm_s16le
INFERENCE_STT_SAMPLE_RATE=16000
INFERENCE_STT_EOT_THRESHOLD=0.7
INFERENCE_STT_EOT_TIMEOUT_MS=5000
INFERENCE_STT_EAGER_EOT_THRESHOLD=0.3

# LLM (Language Model): Groq models
INFERENCE_LLM_MODEL=groq/llama-3.1-8b-instant

# TTS (Text-to-Speech): Deepgram models
INFERENCE_TTS_MODEL=deepgram/aura-2
INFERENCE_TTS_VOICE=aura-2-thalia-en

# Local Whisper STT Fallback (when VOICE_MODE=local)
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_BEAM_SIZE=1
FASTER_WHISPER_LANGUAGE=en