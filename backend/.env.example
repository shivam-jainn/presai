FILE_STORAGE_PATH=content
QDRANT_URL="http://localhost:6333"

# For OpenAI
# export EMBEDDINGS_PROVIDER=openai
# export EMBEDDINGS_API_KEY=your_openai_key

# For Groq
# export EMBEDDINGS_PROVIDER=groq
# export EMBEDDINGS_API_KEY=your_groq_key
# export EMBEDDINGS_MODEL=text-embedding-004

# For Ollama
# export EMBEDDINGS_PROVIDER=ollama
# export EMBEDDINGS_BASE_URL=http://localhost:11434
# export EMBEDDINGS_MODEL=llama2

# For LM Studio
export EMBEDDINGS_PROVIDER=lmstudio
export EMBEDDINGS_BASE_URL=http://localhost:1234  # LM Studio default port
export EMBEDDINGS_MODEL=your_model

# Voice mode: local | agentkit_live
VOICE_MODE=local

# LiveKit/AgentKit runtime settings (required when VOICE_MODE=agentkit_live)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_ROOM_PREFIX=presai-voice
LIVEKIT_TOKEN_TTL_SECONDS=3600

# Inference API model settings (single consistent path)
INFERENCE_STT_MODEL=deepgram/flux-general-en
INFERENCE_STT_ENCODING=pcm_s16le
INFERENCE_STT_SAMPLE_RATE=16000
INFERENCE_STT_EOT_THRESHOLD=0.7
INFERENCE_STT_EOT_TIMEOUT_MS=5000
INFERENCE_STT_EAGER_EOT_THRESHOLD=0.3
INFERENCE_LLM_MODEL=openai/gpt-4o-mini
INFERENCE_TTS_MODEL=deepgram/aura-2
INFERENCE_TTS_VOICE=aura-2-thalia-en

# Faster-Whisper local STT settings
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_BEAM_SIZE=1
FASTER_WHISPER_LANGUAGE=en

DEEPGRAM_API_KEY=your_deepgram_api_keY