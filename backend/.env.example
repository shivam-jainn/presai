# ===========================================
# PresAI Backend Configuration - CLEAN VERSION
# ===========================================

# Debug mode (optional)
PRESAI_DEBUG=false

# File Storage
FILE_STORAGE_PATH=content

# Vector Database
QDRANT_URL=http://localhost:6333
VECTOR_SIZE=768

# ===========================================
# EMBEDDINGS CONFIGURATION
# ===========================================
# Provider: local (Ollama) | openai
EMBEDDINGS_PROVIDER=local

# For local provider (Ollama)
EMBEDDINGS_MODEL_NAME=nomic-embed-text
EMBEDDINGS_MODEL_URL=http://localhost:11434

# For OpenAI provider (uncomment if using)
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL_NAME=text-embedding-3-small
# EMBEDDINGS_API_KEY=sk-your-openai-api-key

# ===========================================
# LLM CONFIGURATION
# ===========================================
# Provider: groq (recommended) | ollama | lmstudio
LLM_PROVIDER=groq

# For Groq (recommended - free tier available)
LLM_MODEL_NAME=llama-3.1-70b-versatile
LLM_API_KEY=gsk_your_groq_api_key_here

# For Ollama (local - uncomment if using)
# LLM_PROVIDER=ollama
# LLM_MODEL_NAME=llama3.1
# LLM_MODEL_URL=http://localhost:11434

# For LM Studio (local - uncomment if using)
# LLM_PROVIDER=lmstudio
# LLM_MODEL_NAME=your-model
# LLM_MODEL_URL=http://localhost:1234

# LLM Settings
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=256

# ===========================================
# STT (SPEECH-TO-TEXT) CONFIGURATION
# ===========================================
# Provider: deepgram (recommended) | groq
STT_PROVIDER=deepgram

# For Deepgram (recommended - uncomment if using)
STT_API_KEY=your-deepgram-api-key
DEEPGRAM_STT_MODEL=nova-3

# For Groq (uses whisper models - uncomment if using)
# STT_PROVIDER=groq
# STT_MODEL_NAME=whisper-large-v3
# STT_API_KEY=${LLM_API_KEY}  # Same as LLM key if using Groq

# ===========================================
# TTS (TEXT-TO-SPEECH) CONFIGURATION
# ===========================================
# Only Deepgram supported
TTS_MODEL_NAME=aura-2
TTS_VOICE=thalia
TTS_API_KEY=your-deepgram-api-key

# ===========================================
# LIVEKIT CONFIGURATION (Voice Runtime)
# ===========================================
VOICE_MODE=local  # local | agentkit_live

# LiveKit Server Settings
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsec
LIVEKIT_ROOM_PREFIX=presai-voice
LIVEKIT_TOKEN_TTL_SECONDS=3600

# ===========================================
# WHISPER FALLBACK (Local STT)
# ===========================================
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
